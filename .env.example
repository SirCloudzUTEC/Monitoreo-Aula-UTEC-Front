# Desarrollo local: npm run setup:local genera .env.local sin sobrescribirlo.
# Vercel: configura estas variables en Settings > Environment Variables.
#
# Este frontend es un cliente puro del backend Spring Boot (../backend): ya no
# maneja sesión, base de datos ni MQTT. Todo eso vive en el backend; ver
# docs/MIGRACION_FRONTEND_BACKEND.md.

# URL del backend Spring Boot (sin barra final). Es pública por diseño: el
# navegador llama directo a la API. En el backend, CORS_ALLOWED_ORIGINS debe
# incluir exactamente el origen de este frontend (p. ej. http://localhost:3000
# en desarrollo y el dominio de Vercel en producción), o el login fallará en
# silencio.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Web Push opcional (sigue haciendo falta en el navegador para
# pushManager.subscribe). Debe ser la MISMA clave pública que VAPID_PUBLIC_KEY
# del backend; la privada vive solo en el backend. Genera el par con:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
