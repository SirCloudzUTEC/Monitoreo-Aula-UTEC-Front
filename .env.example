# Copia este archivo a .env.local y completa los valores.

# Web Push (obligatorio para notificaciones push)
# Genera el par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# MQTT (fase 2: conexión al procesador de aula real; hoy solo documentado)
NEXT_PUBLIC_MQTT_WS_URL=
MQTT_USER=
MQTT_PASS=
