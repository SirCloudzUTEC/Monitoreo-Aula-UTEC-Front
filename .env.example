# Desarrollo local: npm run setup:local genera .env.local sin sobrescribirlo.
# Vercel: configura estas dos variables en Settings > Environment Variables.
# Usa un PIN largo diferente del de desarrollo. Sin ellas, el sitio es solo lectura.
DEMO_ADMIN_PIN=
AUTH_SESSION_SECRET=

# Identidad institucional (pendiente de confirmar proveedor con TI de UTEC).
# SUPERADMIN_EMAIL define la única cuenta que arranca como superadmin.
SUPERADMIN_EMAIL=
GOOGLE_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_ID=

# Web Push opcional. Genera un par de claves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# URI de contacto válida del responsable (mailto:... o https://...).
VAPID_SUBJECT=

# MQTT: fase 2, todavía NO implementado. Nunca exponer MQTT_USER/PASS al cliente.
NEXT_PUBLIC_MQTT_WS_URL=
MQTT_USER=
MQTT_PASS=
