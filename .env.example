# Desarrollo local: npm run setup:local genera .env.local sin sobrescribirlo.
# Vercel: configura estas variables en Settings > Environment Variables.

# Login institucional (Auth.js). AUTH_SECRET firma la sesión: genera uno con
# `openssl rand -base64 48` (o npm run setup:local en desarrollo).
AUTH_SECRET=
DATABASE_URL=

# Proveedor Google: crea un cliente OAuth "Externo" en Google Cloud Console y
# registra la redirect URI http://localhost:3000/api/auth/callback/google
# (y el equivalente de producción/preview).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Fase 2, sin implementar: si UTEC confirma Microsoft Entra como proveedor real.
MICROSOFT_OAUTH_CLIENT_ID=

# SUPERADMIN_EMAIL define la única cuenta @utec.edu.pe que arranca aprobada
# como superadmin; el resto queda pendiente de aprobación manual.
SUPERADMIN_EMAIL=

# Solo para tests e2e locales: habilita un provider Credentials que simula un
# login de superadmin sin pasar por Google real. Nunca definir en producción.
AUTH_TEST_BYPASS_SECRET=

# Web Push opcional. Genera un par de claves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# URI de contacto válida del responsable (mailto:... o https://...).
VAPID_SUBJECT=

# MQTT: fase 2, todavía NO implementado. Nunca exponer MQTT_USER/PASS al cliente.
NEXT_PUBLIC_MQTT_WS_URL=
MQTT_USER=
MQTT_PASS=
